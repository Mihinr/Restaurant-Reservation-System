{
  "name": "restaurant-reservation-system",
  "version": "1.0.0",
  "description": "A microservices-based restaurant reservation system",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" run dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "test": "pnpm --filter \"./packages/*\" run test",
    "test:coverage": "pnpm --filter \"./packages/*\" run test:coverage",
    "lint": "pnpm --filter \"./packages/*\" run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter \"./packages/*\" run db:migrate",
    "db:seed": "pnpm --filter \"./packages/*\" run db:seed"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}

